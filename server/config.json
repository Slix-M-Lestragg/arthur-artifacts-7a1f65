{
  "services": {
    "comfyui": {
      "name": "ComfyUI",
      "default_port": 8188,
      "unit_template": "comfy@{i}",
      "instance_prefix": "comfy",
      "max_instances": 4,
      "multi_instance": true,
      "probe_path": "/system_stats"
    },
    "aitoolkit": {
      "name": "AI Toolkit",
      "default_port": 8675,
      "unit": "ai-toolkit.service",
      "max_instances": 1,
      "multi_instance": false,
      "probe_path": "/"
    }
  },
  "num_gpus": 2
}
