# arthur companion agent — systemd unit — managed by the arthur project.
#
# Deploys to /etc/systemd/system/arthur-agent.service with the script at
# /opt/arthur-agent/arthur-agent.py and config/token in /etc/arthur-agent/.
#   sudo systemctl daemon-reload && sudo systemctl enable --now arthur-agent
#
# Binds 0.0.0.0:8766 (token-gated) so the Obsidian plugin can reach it over
# the LAN — see README-install.md for the tradeoff.

[Unit]
Description=arthur companion agent (ComfyUI lifecycle control)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/arthur-agent/arthur-agent.py
EnvironmentFile=/etc/arthur-agent/env
Restart=on-failure
RestartSec=3

# Hardening. The agent runs as root because it controls system units; it
# needs to write only its audit log under /var/log, only read /etc — and
# rewrite its own config (config-extra forget → atomic tmp+rename in
# /etc/arthur-agent), which ReadWritePaths carves out of ProtectSystem.
#
# v0.8.0 (pi session spawn) adjustments:
#  — ProtectHome=no: the spawn path drops into the pi user's account and
#    execs `pi`, which writes sessions under ~/.pi (read-only /home broke
#    that outright).
#  — PrivateTmp removed: the spawned tmux server's socket lives in the real
#    /tmp/tmux-<uid>/ so the user can actually `tmux attach` to it.
#  — KillMode=process: spawned pi sessions / tmux servers must survive an
#    agent restart (agent upgrades) instead of being swept with its cgroup.
# NoNewPrivileges stays: the uid/gid drop for `user:` spawns happens in
# subprocess' own child setup (setuid syscall), never via setuid binaries.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=no
ReadWritePaths=/etc/arthur-agent
KillMode=process

[Install]
WantedBy=multi-user.target
