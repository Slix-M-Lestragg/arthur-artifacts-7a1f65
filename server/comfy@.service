# ComfyUI multi-instance template unit — managed by the arthur project.
#
#   systemctl start comfy@0   → GPU 0 % NUM_GPUS, port 8188
#   systemctl start comfy@1   → GPU 1 % NUM_GPUS, port 8189
#   systemctl start comfy@2   → GPU 0 (2 % 2), port 8190   ← spawns on a 2-GPU box
#   (port = 8188 + <instance index>; GPU index = <instance index> % NUM_GPUS,
#    computed at START time via `nvidia-smi -L` — instances rotate across the
#    GPUs that exist instead of hard-claiming GPU %i.)
#
# Deploys to /etc/systemd/system/comfy@.service. Needs root:
#   sudo install -m 644 comfy@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Environment is inherited from the ecosystem's shared paths.sh (single
# source of truth: HF_HOME / model paths etc.), plus the Vulkan system-memory
# fallback launch.sh needs for llama.cpp custom nodes.

[Unit]
Description=ComfyUI instance %i (GPU %i mod NUM_GPUS, port 8188+%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/work/00-TOOLS/comfyui
Environment=GGML_VK_ALLOW_SYSMEM_FALLBACK=1
# NUM_GPUS detected live at start (grep -c . on `nvidia-smi -L`, min 1 so a
# driver hiccup degrades to GPU 0 instead of a bash division-by-zero); then
# CUDA_VISIBLE_DEVICES = %i mod NUM_GPUS. Exported BEFORE sourcing paths.sh
# (which only defaults it when unset — our rotation value wins).
ExecStart=/bin/bash -c 'NGPU=$(nvidia-smi -L 2>/dev/null | grep -c .); NGPU=$((NGPU > 0 ? NGPU : 1)); export CUDA_VISIBLE_DEVICES=$(( %i % NGPU )); source /mnt/work/00-TOOLS/paths.sh; exec venv/bin/python main.py --listen 0.0.0.0 --port $((8188 + %i)) --preview-method auto --reserve-vram 2'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
