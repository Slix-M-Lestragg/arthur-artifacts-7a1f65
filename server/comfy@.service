# ComfyUI per-GPU template unit — managed by the arthur project.
#
#   systemctl start comfy@0   → CUDA_VISIBLE_DEVICES=0, port 8188
#   systemctl start comfy@1   → CUDA_VISIBLE_DEVICES=1, port 8189
#   (port = 8188 + <instance index>)
#
# Deploys to /etc/systemd/system/comfy@.service. Needs root:
#   sudo install -m 644 comfy@.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now comfy@0 comfy@1
#
# Environment is inherited from the ecosystem's shared paths.sh (single
# source of truth: HF_HOME / model paths etc.), plus the Vulkan system-memory
# fallback launch.sh needs for llama.cpp custom nodes.

[Unit]
Description=ComfyUI per-GPU instance %i (GPU %i, port 8188+%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/work/00-TOOLS/comfyui
Environment=CUDA_VISIBLE_DEVICES=%i
Environment=GGML_VK_ALLOW_SYSMEM_FALLBACK=1
ExecStart=/bin/bash -c 'source /mnt/work/00-TOOLS/paths.sh; exec venv/bin/python main.py --listen 0.0.0.0 --port $((8188 + %i)) --preview-method auto --reserve-vram 2'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
