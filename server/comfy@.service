# ComfyUI multi-instance template unit — managed by the arthur project.
#
#   systemctl start comfy@0   → port 8188, GPU 0 % NUM_GPUS (modulo default)
#   systemctl start comfy@1   → port 8189, GPU 1 % NUM_GPUS (modulo default)
#   systemctl start comfy@2   → port 8190, GPU 0 (2 % 2)   ← on a 2-GPU box
#
#   (v0.6.0) An ARTHUR_GPUS override env pins an explicit GPU set — set by
#   arthur-agent via a runtime drop-in (/run/systemd/system/comfy@<i>.service.d/
#   override.conf, Environment=ARTHUR_GPUS="0,1") when the spawn asked for
#   specific GPUs. Honor rule:
#     GPUS = ARTHUR_GPUS if set, else <index> % NUM_GPUS (computed live at
#     START time via `nvidia-smi -L`; min 1 so a driver hiccup degrades to
#     GPU 0 instead of a bash division-by-zero). CUDA_VISIBLE_DEVICES=$GPUS.
#     A comma in $GPUS (multi-GPU instance) also adds `--cuda-device 0,1`
#     (indexes relative to the visible devices). A single pinned GPU needs no
#     --cuda-device: it is the only visible device (cuda:0).
#
# Deploys to /etc/systemd/system/comfy@.service. Needs root:
#   sudo install -m 644 comfy@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Environment is inherited from the ecosystem's shared paths.sh (single
# source of truth: HF_HOME / model paths etc.), plus the Vulkan system-memory
# fallback launch.sh needs for llama.cpp custom nodes. CUDA_VISIBLE_DEVICES
# is exported BEFORE sourcing paths.sh (which only defaults it when unset —
# the rotation/override value wins).

[Unit]
Description=ComfyUI instance %i (port 8188+%i, GPUs: drop-in override or index mod NUM_GPUS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/work/00-TOOLS/comfyui
Environment=GGML_VK_ALLOW_SYSMEM_FALLBACK=1
ExecStart=/bin/bash -c 'NGPU=$(nvidia-smi -L 2>/dev/null | grep -c .); NGPU=$((NGPU > 0 ? NGPU : 1)); GPUS="${ARTHUR_GPUS:-$(( %i % NGPU ))}"; export CUDA_VISIBLE_DEVICES=$GPUS; CUDA_ARGS=""; case "$GPUS" in *,*) CUDA_ARGS="--cuda-device 0,1";; esac; source /mnt/work/00-TOOLS/paths.sh; exec venv/bin/python main.py --listen 0.0.0.0 --port $((8188 + %i)) --preview-method auto --reserve-vram 2 $CUDA_ARGS'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
