{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "commonjs",
		"target": "ES2018",
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"noImplicitAny": true,
		"moduleDetection": "force"
	},
	"include": ["src/**/*.ts"]
}
